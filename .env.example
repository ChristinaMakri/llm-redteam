# =============================================================================
# LLM Red-Team Framework — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Judge Model
# The framework uses a separate LLM to evaluate agent responses.
# Choose ONE of the two options below.
# -----------------------------------------------------------------------------

# Option A: Azure OpenAI (recommended for enterprise setups)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Option B: Standard OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Agent Under Test
# Point this at your running LangGraph dev server.
# Start it with: uv run langgraph dev --port 2024
# -----------------------------------------------------------------------------

AGENT_URL=http://localhost:2024
AGENT_ASSISTANT_ID=your-graph-name

# -----------------------------------------------------------------------------
# Optional: LangSmith tracing
# -----------------------------------------------------------------------------

# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
